// schema.prisma — workers-backend
// Runtime: PrismaPg adapter en prisma.service.ts (Pool + connectionString)
// CLI (migrate/generate): lee url del datasource + .env del directorio

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

enum RecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Trazabilidad de todos los jobs async del ecosistema
model JobLog {
  id             String    @id @default(cuid())
  ecosystemId    String
  organizationId String
  queue          String
  jobId          String    @unique
  status         JobStatus @default(PENDING)
  input          Json
  result         Json?
  error          String?
  attempts       Int       @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  durationMs     Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, queue, status])
  @@index([queue, status])
  @@index([jobId])
}

/// Campanas de email masivo programadas
model Campaign {
  id              String         @id @default(cuid())
  ecosystemId     String
  organizationId  String
  templateKey     String
  status          CampaignStatus @default(DRAFT)
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  totalRecipients Int            @default(0)
  sentCount       Int            @default(0)
  failedCount     Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  recipients CampaignRecipient[]

  @@index([organizationId, status])
  @@index([scheduledAt])
  @@index([ecosystemId, organizationId])
}

/// Destinatarios de cada campana — fuente de verdad para el dispatcher
/// ADR-003: recipientIds ahora viene de esta tabla, no de []
model CampaignRecipient {
  id          String          @id @default(cuid())
  campaignId  String
  contactId   String
  email       String?         // cache del email al momento de enqueue (PII — cifrar en S3)
  status      RecipientStatus @default(PENDING)
  sentAt      DateTime?
  failureMsg  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([contactId])
}
