// schema.prisma — workers-backend
// Runtime: PrismaPg adapter en prisma.service.ts (Pool + connectionString)
// CLI (migrate/generate): lee url del datasource + .env del directorio

generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

/// Trazabilidad de todos los jobs async del ecosistema
model JobLog {
  id             String    @id @default(cuid())
  ecosystemId    String
  organizationId String
  queue          String
  jobId          String    @unique
  status         JobStatus @default(PENDING)
  input          Json
  result         Json?
  error          String?
  attempts       Int       @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  durationMs     Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, queue, status])
  @@index([queue, status])
  @@index([jobId])
}

/// Campanas de email masivo programadas
model Campaign {
  id              String         @id @default(cuid())
  ecosystemId     String
  organizationId  String
  templateKey     String
  status          CampaignStatus @default(DRAFT)
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  totalRecipients Int            @default(0)
  sentCount       Int            @default(0)
  failedCount     Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organizationId, status])
  @@index([scheduledAt])
}
