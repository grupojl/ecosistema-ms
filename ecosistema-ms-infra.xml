	curl -s http://localhost:3004/api/v1/dlq/stats | jq .

# ─────────────────────────────────────────────────────────────────────────────
# SETUP INICIAL
# ─────────────────────────────────────────────────────────────────────────────
setup: install docker-up migrate-all
	@echo ""
	@echo "[✓] ecosistema-ms listo"
	@echo ""
	@echo "  1. Editar chatia-backend/.env"
	@echo "  2. Editar pasarelapagos-backend/.env"
	@echo "  3. make seed-chatia"
	@echo "  4. make dev"
	@echo ""
