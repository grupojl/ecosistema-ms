{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "ecosistema-ms.xml",
    "style": "xml",
    "compress": false,
    "showLineNumbers": false,
    "removeComments": false,
    "removeEmptyLines": true,
    "topFilesLength": 10,
    "instructionFilePath": "repomix-instruccion.md"
  },
  "include": [
    "package.json",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
    ".claude/**/*",

    "packages/proto/proto/*.proto",
    "packages/proto/src/index.ts",
    "packages/proto/package.json",
    "packages/auth-server/src/**/*.module.ts",
    "packages/auth-server/src/**/*.guard.ts",
    "packages/auth-server/src/**/*.decorator.ts",
    "packages/auth-server/package.json",
    "packages/grpc-client/src/index.ts",
    "packages/grpc-client/src/**/*.module.ts",
    "packages/grpc-client/package.json",

    "chatia-backend/package.json",
    "chatia-backend/prisma/schema.prisma",
    "chatia-backend/src/main.ts",
    "chatia-backend/src/**/*.module.ts",
    "chatia-backend/src/**/*.controller.ts",
    "chatia-backend/src/**/*.service.ts",
    "chatia-backend/src/**/*.processor.ts",
    "chatia-backend/src/**/*.constants.ts",
    "chatia-backend/src/**/*.interface.ts",
    "chatia-backend/src/**/*.types.ts",
    "chatia-backend/src/**/*.dto.ts",

    "pasarelapagos-backend/package.json",
    "pasarelapagos-backend/prisma/schema.prisma",
    "pasarelapagos-backend/src/main.ts",
    "pasarelapagos-backend/src/**/*.module.ts",
    "pasarelapagos-backend/src/**/*.controller.ts",
    "pasarelapagos-backend/src/**/*.service.ts",
    "pasarelapagos-backend/src/**/*.processor.ts",
    "pasarelapagos-backend/src/**/*.constants.ts",
    "pasarelapagos-backend/src/**/*.interface.ts",
    "pasarelapagos-backend/src/**/*.types.ts",
    "pasarelapagos-backend/src/**/*.dto.ts",

    "notificaciones-backend/package.json",
    "notificaciones-backend/prisma/schema.prisma",
    "notificaciones-backend/src/main.ts",
    "notificaciones-backend/src/**/*.module.ts",
    "notificaciones-backend/src/**/*.controller.ts",
    "notificaciones-backend/src/**/*.service.ts",
    "notificaciones-backend/src/**/*.processor.ts",
    "notificaciones-backend/src/**/*.adapter.ts",
    "notificaciones-backend/src/**/*.helper.ts",
    "notificaciones-backend/src/**/*.constants.ts",
    "notificaciones-backend/src/**/*.interface.ts",
    "notificaciones-backend/src/**/*.dto.ts",

    "analytics-backend/package.json",
    "analytics-backend/prisma/schema.prisma",
    "analytics-backend/src/main.ts",
    "analytics-backend/src/**/*.module.ts",
    "analytics-backend/src/**/*.controller.ts",
    "analytics-backend/src/**/*.service.ts",
    "analytics-backend/src/**/*.processor.ts",
    "analytics-backend/src/**/*.constants.ts",
    "analytics-backend/src/**/*.interface.ts",
    "analytics-backend/src/**/*.dto.ts",

    "workers-backend/package.json",
    "workers-backend/prisma/schema.prisma",
    "workers-backend/src/main.ts",
    "workers-backend/src/**/*.module.ts",
    "workers-backend/src/**/*.controller.ts",
    "workers-backend/src/**/*.service.ts",
    "workers-backend/src/**/*.processor.ts",
    "workers-backend/src/**/*.adapter.ts",
    "workers-backend/src/**/*.helper.ts",
    "workers-backend/src/**/*.constants.ts",
    "workers-backend/src/**/*.interface.ts",
    "workers-backend/src/**/*.dto.ts"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/.git/**",
      "**/.pnpm-store/**",
      "**/coverage/**",
      "**/*.log",
      "**/*.xml",
      "**/*.lock",
      "**/*.tsbuildinfo",
      "**/prisma/client/**",
      "**/prisma/migrations/**",
      "**/prisma/seed.ts",
      "**/generated/**",
      "**/test/**",
      "**/tests/**",
      "**/__mocks__/**",
      "**/.env",
      "**/.env.*",
      "**/x.sh"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}