{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "ecosistema-ms.xml",
    "style": "xml",
    "compress": false,
    "showLineNumbers": false,
    "removeComments": false,
    "removeEmptyLines": false,
    "topFilesLength": 5,
    "instructionFilePath": "repomix-instruccion.md"
  },
  "include": [
    ".claude/**/*.md",
    "package.json",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
    "docker-compose.yml",
    ".npmrc",
    "Makefile",

    "packages/*/package.json",
    "packages/*/tsconfig.json",
    "packages/*/src/**/*.ts",

    "chatia-backend/package.json",
    "chatia-backend/tsconfig.json",
    "chatia-backend/tsconfig.build.json",
    "chatia-backend/nest-cli.json",
    "chatia-backend/Dockerfile",
    "chatia-backend/.dockerignore",
    "chatia-backend/railway.json",
    "chatia-backend/entrypoint.sh",
    "chatia-backend/prisma/schema.prisma",
    "chatia-backend/src/**/*.ts",

    "pasarelapagos-backend/package.json",
    "pasarelapagos-backend/tsconfig.json",
    "pasarelapagos-backend/tsconfig.build.json",
    "pasarelapagos-backend/nest-cli.json",
    "pasarelapagos-backend/Dockerfile",
    "pasarelapagos-backend/.dockerignore",
    "pasarelapagos-backend/railway.json",
    "pasarelapagos-backend/entrypoint.sh",
    "pasarelapagos-backend/prisma/schema.prisma",
    "pasarelapagos-backend/src/**/*.ts",

    "notificaciones-backend/package.json",
    "notificaciones-backend/tsconfig.json",
    "notificaciones-backend/tsconfig.build.json",
    "notificaciones-backend/nest-cli.json",
    "notificaciones-backend/Dockerfile",
    "notificaciones-backend/.dockerignore",
    "notificaciones-backend/railway.json",
    "notificaciones-backend/entrypoint.sh",
    "notificaciones-backend/prisma/schema.prisma",
    "notificaciones-backend/src/**/*.ts",

    "analytics-backend/package.json",
    "analytics-backend/tsconfig.json",
    "analytics-backend/tsconfig.build.json",
    "analytics-backend/nest-cli.json",
    "analytics-backend/Dockerfile",
    "analytics-backend/.dockerignore",
    "analytics-backend/railway.json",
    "analytics-backend/entrypoint.sh",
    "analytics-backend/prisma/schema.prisma",
    "analytics-backend/src/**/*.ts",

    "workers-backend/package.json",
    "workers-backend/tsconfig.json",
    "workers-backend/tsconfig.build.json",
    "workers-backend/nest-cli.json",
    "workers-backend/Dockerfile",
    "workers-backend/.dockerignore",
    "workers-backend/railway.json",
    "workers-backend/entrypoint.sh",
    "workers-backend/prisma/schema.prisma",
    "workers-backend/src/**/*.ts"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/.git/**",
      "**/*.log",
      "**/*.xml",
      "**/*.lock",
      "**/*.tsbuildinfo",
      "**/prisma/client/**",
      "**/prisma/migrations/**",
      "**/prisma/seed.ts",
      "**/generated/**",
      "**/.env",
      "**/.env.*",
      "**/__mocks__/**",
      "**/*.spec.ts",
      "**/*.e2e-spec.ts",
      "**/test/**",
      "**/tests/**",
      "**/coverage/**"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}