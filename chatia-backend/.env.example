# =============================================================================
# chatia-backend — .env.example
# Railway: Root Directory=/  |  Dockerfile Path=chatia-backend/Dockerfile
# Puerto HTTP: 3010  |  Puerto gRPC: 5010
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Railway: conectar el plugin PostgreSQL y usar la variable DATABASE_URL que genera
DATABASE_URL=postgresql://user:password@postgres.railway.internal:5432/chatia_db

# ── Redis (compartido con todos los servicios) ────────────────────────────────
REDIS_URL=redis://default:password@redis.railway.internal:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=
# JSON del service account de Firebase en UNA SOLA LÍNEA
FIREBASE_ADMIN_CREDENTIALS={"type":"service_account","project_id":"","private_key_id":"","private_key":"","client_email":"","client_id":"","auth_uri":"","token_uri":""}

# ── IA — Groq ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=
# Opcional: fuerza el modelo de Groq para todos los chats (pisa AssistantConfig.groqModel)
# GROQ_MODEL=openai/gpt-oss-120b

# ── IA — Proveedores de fallback ──────────────────────────────────────────────
# Cada capacidad es una cadena: si un proveedor cae o no tiene clave, se pasa al siguiente.
# Si toda la cadena cae: el usuario recibe "reintentá" + alerta técnica (nunca handoff a humano).
# Ref: .claude/infrastructure/providers-fallback.md

# LLM (chat + intent + RAG): groq → siliconflow
# LLM_PROVIDERS=groq,siliconflow
SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1    # .cn si la cuenta es de China
# SILICONFLOW_LLM_MODEL=openai/gpt-oss-120b              # verificar el id exacto en SiliconFlow
# SILICONFLOW_LLM_MODEL_SMALL=                           # para intent; vacío = usa el grande

# Speech-to-text: groq (whisper) → siliconflow. SiliconFlow queda apagado hasta definir el modelo
# (probar calidad en español antes de habilitarlo).
# STT_PROVIDERS=groq,siliconflow
# SILICONFLOW_STT_MODEL=

# Text-to-speech: cartesia → elevenlabs (ambos con voz clonada por org)
# TTS_PROVIDERS=cartesia,elevenlabs
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_OUTPUT_FORMAT=opus_48000_64                 # verificar que sea Opus en Ogg (WhatsApp)

# Imagen a texto: anthropic → groq (Llama 4 Scout) → siliconflow (Qwen3-VL). Probar antes de migrar.
# IMAGE_PROVIDERS=anthropic,groq,siliconflow
ANTHROPIC_API_KEY=
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# SILICONFLOW_VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct

# Embeddings (FAQ/RAG). Sin fallback entre modelos: cambiarlo obliga a reindexar, y
# workers-backend debe indexar con el MISMO modelo.
# EMBEDDINGS_PROVIDER=siliconflow
# EMBEDDINGS_MODEL=BAAI/bge-m3

# ── Cifrado en reposo de tokens de canales (OBLIGATORIA en producción) ───────
# 32 bytes en base64:  openssl rand -base64 32
# Cifra ChannelAccount.accessToken y extraConfig.appSecret con AES-256-GCM.
# Para rotar: poner la nueva en CHANNEL_TOKEN_ENCRYPTION_KEY y la vieja en _PREVIOUS (solo descifra).
# Cifrar datos existentes: pnpm encrypt:tokens  (DRY_RUN=1 para simular)
CHANNEL_TOKEN_ENCRYPTION_KEY=
# CHANNEL_TOKEN_ENCRYPTION_KEY_PREVIOUS=

# ── Widget / seguridad ────────────────────────────────────────────────────────
# Firma de la sesión del widget (≥32 caracteres, obligatoria en producción)
WIDGET_SESSION_SECRET=
# Ver límites opcionales: WIDGET_CHAT_PER_MIN_SESSION, WIDGET_CHAT_PER_MIN_IP, WIDGET_DAILY_QUOTA, THROTTLE_LIMIT_PER_MIN
# Solo desarrollo local (NUNCA en producción: la validación de entorno lo impide):
# ALLOW_DEV_AUTH=true
# SWAGGER_ENABLED=true
# NODE_ENV es obligatorio (development | production | test)

# ── Meta / WhatsApp ───────────────────────────────────────────────────────────
# Webhooks entrantes de Meta apuntan a: https://chatia-backend.railway.app/api/v1/webhooks/whatsapp
META_SYSTEM_TOKEN=
META_APP_SECRET=
META_PHONE_NUMBER_ID=
# ADR-024: app de la plataforma (Tech Provider). META_APP_ID + META_APP_SECRET habilitan el alta por Embedded Signup
META_APP_ID=
# Webhook ÚNICO de la app (Tech Provider): Meta registra UNA url de callback para todos los clientes → .../api/v1/webhooks/whatsapp
# Este es el "Verify token" que se escribe en Meta (cualquier cadena larga y aleatoria). Sin él el GET de verificación se rechaza.
META_WEBHOOK_VERIFY_TOKEN=
# Versión de la Graph API (formato v23.0). Si falta, usa v23.0
META_GRAPH_VERSION=

# ── ADR-003: URLs de microservicios nuevos ────────────────────────────────────
# URL pública (para redireccionamiento 410 Gone en endpoints deprecados)
ANALYTICS_BACKEND_URL=https://analytics-backend.railway.app
# URLs internas Railway (red privada — no cambiar el formato)
ANALYTICS_GRPC_URL=analytics-backend.railway.internal:5012
NOTIF_GRPC_URL=notificaciones-backend.railway.internal:5013
WORKERS_GRPC_URL=workers-backend.railway.internal:5014

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3010
GRPC_PORT=5010
INTERNAL_API_KEY=
