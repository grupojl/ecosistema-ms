{
  "name": "chatia-backend",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate && nest build && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "prisma generate && nest start --watch --exec \"tsc-alias -p tsconfig.build.json && node\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:migrate": "prisma migrate deploy",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:integration": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js src/infrastructure/testing/integration",
    "test:watch": "jest --watch",
    "encrypt:tokens": "node dist/infrastructure/maintenance/cli.js encrypt-tokens",
    "typecheck": "prisma generate && tsc --noEmit",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@ecosistema-ms/auth-server": "workspace:*",
