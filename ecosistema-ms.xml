syntax = "proto3";

package chatia;

// ─── Servicio Chat IA ──────────────────────────────────────────────────────
// Puerto gRPC interno: 5001
// Usado por: pasarelapagos-backend, futuros microservicios
service ChatIaService {
  // Enviar mensaje a un proyecto de chat
  rpc SendMessage (SendMessageRequest) returns (SendMessageResponse);
  // Consultar estado de un proyecto
  rpc GetProject (GetProjectRequest) returns (GetProjectResponse);
  // Health check inter-servicio
