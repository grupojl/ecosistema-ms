<file path="analytics-backend/src/main.ts">
import 'reflect-metadata';
import { NestFactory }         from '@nestjs/core';
import { MicroserviceOptions, Transport } from '@nestjs/microservices';
import { ValidationPipe }      from '@nestjs/common';
import { DocumentBuilder, SwaggerModule } from '@nestjs/swagger';
import { Logger }              from 'nestjs-pino';
import { join }                from 'path';
import { AppModule }           from '@/app.module.js';
import { ZodExceptionFilter }  from '@ecosistema-ms/auth-server';

async function bootstrap(): Promise<void> {
  const app = await NestFactory.create(AppModule, { bufferLogs: true });

  // ── Pino structured logger ─────────────────────────────────────────────
  app.useLogger(app.get(Logger));

  // ── gRPC microservice ──────────────────────────────────────────────────
  app.connectMicroservice<MicroserviceOptions>({
    transport: Transport.GRPC,
    options: {
      package:   'analytics',
      protoPath:  join(process.cwd(), 'proto', 'analytics.proto'),
      url:        `0.0.0.0:${process.env['GRPC_PORT'] ?? '5004'}`,
      channelOptions: {
        'grpc.keepalive_time_ms':             10_000,
        'grpc.keepalive_timeout_ms':           5_000,
        'grpc.keepalive_permit_without_calls':     1,
        'grpc.http2.max_pings_without_data':       0,
      },
    },
  });

  // ── Filtros globales — ZodExceptionFilter PRIMERO (ADR-009 / DT-027) ──
  app.useGlobalFilters(new ZodExceptionFilter());
  app.useGlobalPipes(new ValidationPipe({
    whitelist:            true,
    forbidNonWhitelisted: true,
    transform:            true,
  }));

  // ── Swagger ────────────────────────────────────────────────────────────
  const swaggerCfg = new DocumentBuilder()
    .setTitle('analytics-backend')
    .setVersion('1.0')
    .addBearerAuth()
    .build();
  SwaggerModule.setup('api/docs', app, SwaggerModule.createDocument(app, swaggerCfg));

  // ── Arranque ───────────────────────────────────────────────────────────
  await app.startAllMicroservices();
  const port = process.env['PORT'] ?? '3003';
  await app.listen(port);
  app.get(Logger).log(
    `HTTP:${port}  gRPC:5004`,
    'analytics-backend',
  );
}

void bootstrap();
</file>

<file path="chatia-backend/prisma/schema.prisma">
// =============================================================================
// prisma/schema.prisma
// Chat IA — Sistema hoja del ecosistema SaaS multi-tenant
//
// CAMBIOS vs versión anterior:
//   • Organization: @id sin @default(cuid()) — el ID lo asigna el owner-dashboard
//   • Organization: se agrega slug + isActive para referencia local
//   • Agent: se agrega roles String[] y email unique para upsert SSO
//   • Todo lo demás sin cambios
//
// MIGRACIÓN: pnpm prisma migrate dev --name sso_ecosystem_contract
// =============================================================================

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}


// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  MESSENGER
  TIKTOK
}

enum ConversationStatus {
  OPEN
  HUMAN_TAKEOVER
  RESOLVED
  EXPIRED
}

enum ConversationStage {
  INITIAL
  QUALIFYING
  INFORMED
  NEGOTIATING
  CLOSING
  FOLLOW_UP
  HUMAN
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
  TEMPLATE
  SYSTEM
}

enum ContactStatus {
  ACTIVE
  BLOCKED
  UNSUBSCRIBED
}

enum KbDocumentStatus {
  PENDING
  PROCESSING
  INDEXED
  FAILED
}

enum KbSourceType {
  TEXT
  MARKDOWN
  PDF
  URL
  JSON
}

enum NotificationType {
  NEW_CONVERSATION
  NEW_MESSAGE
  ESCALATION
}

// ─────────────────────────────────────────────
// ECOSYSTEM — plataforma multi-ecosistema (ADR-001)
// ─────────────────────────────────────────────

model Ecosystem {
  id                String   @id @default(cuid())
  firebaseProjectId String   @unique
  name              String
  isActive          Boolean  @default(true)
  config            Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organizations Organization[]

  @@index([firebaseProjectId])
}

// ─────────────────────────────────────────────
// ORGANIZACIÓN
// Referencia ligera — source of truth es el owner-dashboard.
// El ID viene del dashboard (UUID externo), no se genera localmente.
// Se crea/actualiza automáticamente en cada request via TenantGuard (upsert pasivo).
// ─────────────────────────────────────────────

model Organization {
  id          String   @id
  ecosystemId String                    // ← NUEVO
  name        String
  slug        String?  @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ecosystem       Ecosystem        @relation(fields: [ecosystemId], references: [id])  // ← NUEVO
  channelAccounts ChannelAccount[]
  contacts        Contact[]
  agents          Agent[]
  projects        Project[]

  @@index([ecosystemId])  // ← NUEVO
  @@index([slug])
}

// ─────────────────────────────────────────────
// AGENTE (usuario del dashboard con acceso a Chat IA)
// Se crea/actualiza via upsert en TenantGuard en cada login.
// Los roles se cachean desde productPermissions del owner-dashboard.
// ─────────────────────────────────────────────

model Agent {
  id             String   @id @default(cuid())
  organizationId String
  firebaseUid    String   @unique
  name           String
  email          String   @unique  // agregado para upsert por email
  avatarUrl      String?
  role   String   @default("MEMBER")  // cacheado desde owner-dashboard
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id])
  conversations  Conversation[]
  notifications  Notification[]

  @@index([organizationId])
}

// ─────────────────────────────────────────────
// PROYECTO (agrupa configuraciones de IA)
// ─────────────────────────────────────────────

model Project {
  id             String   @id @default(cuid())
  organizationId String
  slug           String
  name           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id])
  assistantConfigs AssistantConfig[]
  knowledgeBases   KnowledgeBase[]
  channelAccounts  ChannelAccount[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

// ─────────────────────────────────────────────
// CANAL (multi-canal: WhatsApp, IG, Messenger, TikTok)
// ─────────────────────────────────────────────

model ChannelAccount {
  id             String      @id @default(cuid())
  organizationId String
  channelType    ChannelType
  name           String

  externalId         String
  accessToken        String
  extraConfig        Json    @default("{}")
  webhookVerifyToken String  @default(cuid())
  isActive           Boolean @default(true)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  conversations Conversation[]
  aiConfig      AiConfig?

  @@unique([channelType, externalId])
  @@index([organizationId])
}

// ─────────────────────────────────────────────
// CONTACTO
// ─────────────────────────────────────────────

model Contact {
  id             String        @id @default(cuid())
  organizationId String
  channelType    ChannelType
  externalId     String

  name       String?
  avatarUrl  String?
  email      String?
  phone      String?
  username   String?

  status    ContactStatus @default(ACTIVE)
  optedOut  Boolean       @default(false)
  tags      String[]      @default([])
  metadata  Json          @default("{}")

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  conversations Conversation[]

  @@unique([organizationId, channelType, externalId])
  @@index([organizationId])
}

// ─────────────────────────────────────────────
// CONVERSACIÓN
// ─────────────────────────────────────────────

model Conversation {
  id               String             @id @default(cuid())
  channelAccountId String
  contactId        String

  status          ConversationStatus @default(OPEN)
  stage           ConversationStage  @default(INITIAL)
  isAiActive      Boolean            @default(true)
  assignedAgentId String?

  detectedIntent    String?
  extractedEntities Json    @default("{}")
  summary           String?
  tags              String[] @default([])

  marketCountry  String?  @map("market_country")  // ADR-014 — ISO 3166-1 alpha-2
  lastMessageAt DateTime?
  resolvedAt    DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id])
  contact        Contact        @relation(fields: [contactId], references: [id])
  assignedAgent  Agent?         @relation(fields: [assignedAgentId], references: [id])
  messages       Message[]
  agentState     AgentState?
  notifications  Notification[]

  @@index([channelAccountId])
  @@index([contactId])
  @@index([status])
}

// ─────────────────────────────────────────────
// MENSAJE
// ─────────────────────────────────────────────

model Message {
  id             String           @id @default(cuid())
  conversationId String

  direction    MessageDirection
  type         MessageType      @default(TEXT)
  status       MessageStatus    @default(SENT)
  content      String
  mediaUrl     String?
  mediaCaption String?

  isAiGenerated Boolean @default(false)
  tokensUsed    Int?
  modelUsed     String?
  externalId    String?
  metadata      Json    @default("{}")

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@unique([conversationId, externalId])
  @@index([conversationId])
}

// ─────────────────────────────────────────────
// ESTADO LANGGRAPH
// ─────────────────────────────────────────────

model AgentState {
  id             String       @id @default(cuid())
  conversationId String       @unique
  currentNode    String       @default("classify")
  context        Json         @default("{}")
  updatedAt      DateTime     @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id])
}

// ─────────────────────────────────────────────
// CONFIGURACIÓN DE IA (por canal)
// ─────────────────────────────────────────────

model AiConfig {
  id               String @id @default(cuid())
  channelAccountId String @unique

  systemPrompt      String  @default("")
  personaName       String  @default("Asistente")
  groqModel         String  @default("llama-3.3-70b-versatile")
  temperature       Float   @default(0.7)
  maxTokens         Int     @default(1024)
  contextWindowSize Int     @default(10)

  humanTakeoverKeywords String[] @default([])
  autoResolveAfterHours Int      @default(24)

  welcomeMessage String?
  offlineMessage String?
  isEnabled      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id])
}

// ─────────────────────────────────────────────
// NOTIFICACIONES
// ─────────────────────────────────────────────

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  agentId        String
  conversationId String?
  type           NotificationType
  title          String
  body           String
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())

  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([organizationId])
  @@index([isRead])
}

// ─────────────────────────────────────────────
// ASISTENTE — configuración por proyecto
// ─────────────────────────────────────────────

model AssistantConfig {
  id             String @id @default(cuid())
  projectId      String @unique
  organizationId String

  personaName     String  @default("Asistente")
  systemPrompt    String  @default("")
  groqModel       String  @default("llama-3.3-70b-versatile")
  temperature     Float   @default(0.7)
  maxTokens       Int     @default(1024)
  contextWindow   Int     @default(10)
  welcomeMessage  String?
  fallbackMessage String?
  allowedOrigins  String[] @default([])

  useFaqFallback Boolean @default(false)
  faqKbId        String?

  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project            @relation(fields: [projectId], references: [id])
  sessions AssistantSession[]

  @@index([organizationId])
}

// ─────────────────────────────────────────────
// ASISTENTE — sesiones de usuario final
// ─────────────────────────────────────────────

model AssistantSession {
  id                String @id @default(cuid())
  assistantConfigId String
  organizationId    String
  externalUserId    String
  channel           String @default("api")

  history       Json      @default("[]")
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?

  config AssistantConfig @relation(fields: [assistantConfigId], references: [id])

  @@index([assistantConfigId])
  @@index([organizationId, externalUserId])
}

// ─────────────────────────────────────────────
// FAQ — base de conocimiento por proyecto
// ─────────────────────────────────────────────

model KnowledgeBase {
  id             String  @id @default(cuid())
  projectId      String
  organizationId String
  name           String
  description    String?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project      @relation(fields: [projectId], references: [id])
  documents KbDocument[]

  @@index([projectId])
  @@index([organizationId])
}

// ─────────────────────────────────────────────
// FAQ — documentos indexables
// ─────────────────────────────────────────────

model KbDocument {
  id              String           @id @default(cuid())
  knowledgeBaseId String
  organizationId  String

  title        String
  sourceType   KbSourceType     @default(TEXT)
  sourceUrl    String?
  rawContent   String?
  status       KbDocumentStatus @default(PENDING)
  errorMessage String?

  tags       String[] @default([])
  metadata   Json     @default("{}")
  chunkCount Int      @default(0)

  indexedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id])
  chunks        KbChunk[]

  @@index([knowledgeBaseId])
  @@index([status])
}

// ─────────────────────────────────────────────
// FAQ — chunks con embeddings
// MVP: JSON array de floats
// Producción: migrar a Unsupported("vector(1536)") con pgvector
// ─────────────────────────────────────────────

model KbChunk {
  id         String @id @default(cuid())
  documentId String
  content    String
  chunkIndex Int

  embedding Json?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  document KbDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}
</file>

