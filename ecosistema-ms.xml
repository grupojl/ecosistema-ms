      // - registrar métricas de negocio
      // - disparar webhooks del proyecto
      this.logger.debug(
        `afterResponse WELVER — projectId: ${context.meta.projectId}`,
      );
    } catch (error) {
      // afterResponse nunca rompe el flujo — solo loguea
      this.logger.error(
