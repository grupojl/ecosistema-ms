message GetPaymentStatusRequest {
  string payment_id       = 1;
  string organization_id  = 2;
}

message GetPaymentStatusResponse {
  bool   found    = 1;
  string status   = 2;  // PENDING | COMPLETED | FAILED | REFUNDED
  int64  amount_cents = 3;
  string currency = 4;
}

message PingRequest  { string caller = 1; }
