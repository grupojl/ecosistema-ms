help:
	@echo "================================================="
	@echo "  ecosistema-ms"
	@echo "================================================="
	@echo ""
	@echo "  make r             → repomix + copia XMLs a Downloads"
	@echo "  make x             → ejecuta x.sh (script activo)"
	@echo "  make g             → git add + commit + push"
	@echo "  make git-empty     → empty commit → fuerza redeploy Railway"
