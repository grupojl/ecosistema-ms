// chatia-backend/src/assistant/chat/assistant-chat.service.ts
import { GroqCbService, CircuitOpenError } from '../../groq/groq-cb.service.js';

// En el metodo chat():
try {
  const response = await this.groqCb.chat(messages, model, temperature);
