{
  "name": "@ecosistema-ms/auth-server",
  "version": "0.0.0",
  "private": true,
  "description": "Guards, decorators y FirebaseModule compartidos — NestJS backends del ecosistema-ms",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "firebase-admin": "catalog:",
    "reflect-metadata": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "tsc-alias": "catalog:",
    "@types/express": "catalog:"
  },
  "peerDependencies": {
    "@nestjs/common": ">=11.0.0",
    "firebase-admin": ">=13.0.0"
  }
}
