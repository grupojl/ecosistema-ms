# ── DB (separada del operacional) ────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5437/analytics_db

# ── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# ── gRPC inbound ─────────────────────────────────────
GRPC_PORT=5004

# ── Proyecciones ─────────────────────────────────────
FORCE_PROJECTION_RUN=false

# ── Cache TTL (ms) ───────────────────────────────────
CACHE_TTL_MS=300000

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=
FIREBASE_ADMIN_CREDENTIALS=
