# marketing-backend/.env.example — copiar a .env y completar
# Ref: .claude/conventions/entorno.md

NODE_ENV=development
PORT=3005
GRPC_PORT=5006
LOG_LEVEL=debug

# DB — PostgreSQL dedicado
DATABASE_URL=postgresql://postgres:password@localhost:5432/marketing_db

# Redis — MISMO que pasarelapagos-backend (cross-service queue marketing-attribution)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Mismo valor en todos los MS + superadmin
INTERNAL_API_KEY=

# Meta Ads API
META_APP_ID=
META_APP_SECRET=

# Google Ads API (Fase 2)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=

# TikTok Ads API (Fase 2)
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

MARKETING_SYNC_INTERVAL_MINUTES=15
MARKETING_AUTOMATION_INTERVAL_HOURS=1
